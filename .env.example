# Copia a .env y rellena valores
# Metadatos YouTube (canales, vídeos, comentarios) — NO descarga subtítulos por sí sola
YOUTUBE_API_KEY=

# --- Transcripciones ---
# La API key de arriba y el OAuth de abajo son credenciales DIFERENTES en Google Cloud.
# auto (recomendado) = Data API → Worker CF → scrape
# worker = solo Cloudflare Worker (timedtext público, sin tu IP)
# data_api = solo captions OAuth (vídeos que puedes editar / propios)
# scrape = youtube-transcript-api directo (puede IpBlocked)
VIDEOMAKER_TRANSCRIPT_PROVIDER=auto

# Cloudflare Worker (gratis ~100k req/día) — ver workers/youtube-transcript-proxy/README.md
# YOUTUBE_TRANSCRIPT_WORKER_URL=https://videomaker-youtube-transcript.<cuenta>.workers.dev
# YOUTUBE_TRANSCRIPT_WORKER_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# OAuth en modo «Testing»: añade tu Gmail en Pantalla de consentimiento → Usuarios de prueba
# Luego: python youtube_oauth_setup.py

# Pausa entre vídeos al descargar lote (quota + rate limit)
# YOUTUBE_TRANSCRIPT_FETCH_DELAY_SEC=0.5

# Solo si VIDEOMAKER_TRANSCRIPT_PROVIDER=scrape|auto y necesitas proxy (IpBlocked)
# YOUTUBE_TRANSCRIPT_PROXY_HTTP=
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=

NEON_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# --- LLM (routing fijo en código) ---
# Creativo (Anthropic): Topic Generator, inferencia Prompt, Script Writer
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_OUTPUT_TOKENS=8192
# ANTHROPIC_TIMEOUT_SEC=600
# Guiones >=14 min usan generación por etapas (varias llamadas Claude). Desactivar: VIDEOMAKER_SCRIPT_STAGED=0

# Producción (OpenAI API): Metadata, Hook Scene Router, Body Scene Router
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Miniaturas en Metadata → OpenAI Images API (misma OPENAI_API_KEY):
#
# 16:9 exacto, ancho ≥640 (recomendado YouTube):
#   OPENAI_IMAGE_MODEL=gpt-image-2
#   OPENAI_IMAGE_SIZE=1280x720
#   (también válido: 1920x1080, 1152x648 — ancho y alto múltiplos de 16)
#
# 16:9 ~aprox con tamaños fijos DALL·E 3:
#   OPENAI_IMAGE_MODEL=dall-e-3
#   OPENAI_IMAGE_SIZE=1792x1024
#
# gpt-image-1 solo admite 1024x1024 | 1536x1024 | 1024x1536 (1536x1024 ≈ 3:2, no 16:9):
#   OPENAI_IMAGE_MODEL=gpt-image-1
#   OPENAI_IMAGE_SIZE=1536x1024
#
# OPENAI_IMAGE_QUALITY=standard
# OPENAI_IMAGES_BATCH_DELAY_SEC=1.0
# OPENAI_IMAGES_MOCK=1

# Legacy / no usado por los pasos de pipeline anteriores (Ollama local)
# VIDEOMAKER_LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2:latest

# Image Prompt Writer: Hook + Body routers → image_prompts.json (sin secs_per_image). 0 = legacy.
# VIDEOMAKER_IPW_ROUTER_DRIVEN=1

# --- Scene Editor (TTS por bloque) — ElevenLabs recomendado ---
# API key: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# Voice ID: ElevenLabs → Voices → ⋮ → Copy voice ID
ELEVENLABS_VOICE_ID=
# Por defecto turbo multilingüe (rápido). Alternativa más estable: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# VIDEOMAKER_SCENE_TTS_PROVIDER=elevenlabs
# Si no hay API key, el Scene Editor usa mock (silencio ~2 s).
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEAKER_BOOST=1
# Pausa entre bloques en generación masiva (ms). Evita rate limits de ElevenLabs.
# ELEVENLABS_BATCH_DELAY_MS=350

# --- Visual Planner (Scene Editor) — Nano Banana 2 ---
# Pausa entre llamadas LLM al planificar prompts visuales por bloque (ms).
# VISUAL_PLANNER_BATCH_DELAY_MS=400
# Ajustes por sesión: pipeline/scene_visual_settings.json (estilo base + protagonista)

# --- Images Generation — Google Imagen (Gemini API) ---
GOOGLE_API_KEY=
# Modelo Imagen (Gemini API). Alternativa: imagen-4.0-generate-001
# GOOGLE_IMAGEN_MODEL=imagen-3.0-generate-002
# GOOGLE_IMAGEN_ASPECT_RATIO=16:9
# Mock sin API (PNG placeholder local): GOOGLE_IMAGEN_MOCK=1
# Pausa entre imágenes en batch (segundos)
# GOOGLE_IMAGEN_BATCH_DELAY_SEC=1.5

# --- Gemini Pro vía navegador (Images Generation → cola, misma conversación) ---
# Chrome con depuración remota (ver hint en la UI o chrome_launch_hint en backend)
# GEMINI_WEB_CDP_URL=http://127.0.0.1:9222
# GEMINI_WEB_DELAY_SEC=28
# GEMINI_WEB_RESPONSE_TIMEOUT_SEC=120
# Carpeta donde Chrome guarda descargas (por defecto ~/Downloads)
# GEMINI_WEB_DOWNLOADS_DIR=/Users/tu_usuario/Downloads
# GEMINI_WEB_READY_MIN_PX=400
# Pausa tras imagen lista antes de pulsar Descargar (ms)
# GEMINI_WEB_POST_READY_MS=2500
# Validación del PNG guardado: descarga manual suele ser varios MB
# GEMINI_WEB_MIN_FILE_BYTES=1500000
# GEMINI_WEB_MIN_SAVED_PX=1200
# Solo si falla la descarga oficial: DOM/URL/captura (~1 MB, baja calidad)
# GEMINI_WEB_ALLOW_PREVIEW_FALLBACK=0
# Quitar estrella/rombo Gemini en pipeline/images (inpainting esquina)
# GEMINI_WATERMARK_CORNER=bottom-right
# Radio del rombo (~4.2% del lado corto)
# GEMINI_WATERMARK_R_RATIO=0.042
# GEMINI_WATERMARK_MARGIN_RATIO=0.028
# GEMINI_WATERMARK_DILATE=7
# GEMINI_WATERMARK_INPAINT_RADIUS=22

# Scene Editor: silencio entre bloques al unificar → narracion.wav (ms)
# SCENE_AUDIO_CHUNK_GAP_MS=0
# Mínimo lado en px para ignorar avatares/iconos (legacy, usa READY)
# GEMINI_WEB_MIN_IMAGE_PX=400

# --- XTTS v2 (clonación de voz, opcional) ---
# Desactiva todos los ajustes de Videomaker y usa solo lo que traiga Coqui:
# VIDEOMAKER_XTTS_DISABLE_TUNING=1
#
# Temperatura (menor → más estable / más “pegado” al clon; típico 0.55–0.75)
# VIDEOMAKER_XTTS_TEMPERATURE=0.68
# VIDEOMAKER_XTTS_TOP_P=0.82
# VIDEOMAKER_XTTS_REPETITION_PENALTY=10
# Normalizar volumen de los cortes de referencia (recomendado con MP3)
# VIDEOMAKER_XTTS_SOUND_NORM_REFS=true
# Segundos de audio usados para acondicionar el modelo (más ≠ siempre mejor; 12–24)
# VIDEOMAKER_XTTS_GPT_COND_LEN=18
# VIDEOMAKER_XTTS_GPT_COND_CHUNK_LEN=6
# VIDEOMAKER_XTTS_MAX_REF_LEN=12

# Narración: silencio entre párrafos en segundos (pydub; 0 desactiva y usa un solo flujo)
# VIDEOMAKER_PARAGRAPH_PAUSE_SEC=2
# Fade-out al final de cada párrafo antes del silencio (ms)
# VIDEOMAKER_PARAGRAPH_FADE_OUT_MS=100
# Desvanecimiento entre frases / trozos TTS consecutivos (mismo párrafo; prioridad sobre CONCAT)
# VIDEOMAKER_PHRASE_FADE_MS=100
# (Legado) Si no defines PHRASE_FADE_MS, se usa este valor para el fade entre frases
# VIDEOMAKER_CONCAT_FADE_MS=15

# Scene Editor — máximo segundos por plano antes de dividir en sub-escenas (vacío = visual_density del prompt)
# VIDEOMAKER_MAX_VISUAL_HOLD_S=5
# Mínimo de macro_beats en body router (suplemento desde outline/B-ROLL)
# VIDEOMAKER_BODY_MIN_MACRO_BEATS=12
# Segundos objetivo por imagen (tras medir/estimar audio)
# VIDEOMAKER_HOOK_TARGET_HOLD_S=3.5
# VIDEOMAKER_BODY_TARGET_HOLD_S=6.5
# Tope duro al montar (no planos estáticos de 10s+)
# VIDEOMAKER_HOOK_MAX_HOLD_S=4.5
# VIDEOMAKER_BODY_MAX_HOLD_S=8
# Tope global opcional (0 = sin tope). Ej. 400 para vídeos muy largos
# VIDEOMAKER_SANITY_MAX_TOTAL_IMAGES=0
# Reparto equitativo del audio entre beats al reconciliar (1=activo por defecto)
# VIDEOMAKER_BODY_EQUAL_BEAT_WEIGHTS=1
# Gancho en Image Prompt Writer: contrapunto visual con LLM (0 = solo plantillas locales)
# VIDEOMAKER_HOOK_COUNTERPOINT_LLM=1
# VIDEOMAKER_HOOK_COUNTERPOINT_TEMPERATURE=0.75

# Subtitle Engine — Whisper local (openai-whisper en requirements)
# VIDEOMAKER_WHISPER_MODEL=base
# VIDEOMAKER_WHISPER_WORD_LEVEL=1   # 1 = timestamps por palabra en subtitles_plan.json

# Render draft (MoviePy): zoom Ken Burns en imágenes (0 = plano fijo, más estable)
# RENDER_KEN_BURNS=1
# Intensidad del zoom final (1.03 ≈ 3 %)
# RENDER_KEN_BURNS_ZOOM=1.03
# Motor: pil (transform afín + 30 fps) o ffmpeg (filtro zoompan, suele ser más fluido)
# RENDER_KEN_BURNS_ENGINE=eased    # default: zoom suave (ease in-out), mismo criterio que preview fluido
# RENDER_KEN_BURNS_ENGINE=ffmpeg   # zoompan lineal (más brusco al inicio/fin de cada plano)
# RENDER_KEN_BURNS_ZOOM=1.05       # zoom final relativo (1.03–1.06 típico)
# RENDER_FPS=30
# Checkpoints de planos (reanudar tras corte): pipeline/render_segments/ + render_segments_checkpoint.json
# RENDER_CHECKPOINT_EVERY=5        # guardar manifiesto cada N planos (los MP4 se escriben siempre)
# RENDER_KEEP_SEGMENTS=0           # 1 = no borrar segmentos tras draft.mp4 listo
